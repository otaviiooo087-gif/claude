rules_version = '2';

// Regras do Firestore para o Painel Operacional / Zimba Festa.
// Cole isso em: Firebase Console > Firestore Database > Regras.
//
// A primeira conta (admin) é criada manualmente no Console (Authentication +
// um documento em usuarios/{uid} com role: "admin") — de propósito o app não
// tem um botão de "criar conta admin" pela web, para ninguém conseguir se
// autopromover a admin sabendo só a chave pública do projeto.
service cloud.firestore {
  match /databases/{database}/documents {
    function estaLogado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    match /usuarios/{uid} {
      allow read: if estaLogado() && (request.auth.uid == uid || ehAdmin());
      // Só o admin cria contas de operador pelo app; a conta admin em si é
      // criada manualmente no Console (ver comentário acima).
      allow create, update, delete: if ehAdmin();
    }

    match /localizacoes/{uid} {
      allow read: if ehAdmin() || (estaLogado() && request.auth.uid == uid);
      // Cada operador só escreve a própria localização.
      allow write: if estaLogado() && request.auth.uid == uid;
      // O admin pode limpar do mapa quem foi removido da equipe.
      allow delete: if ehAdmin();

      match /rota/{id} {
        // Rastro (histórico de posições) do dia — só o admin acompanha o
        // trajeto de todo mundo; cada operador só grava o próprio.
        allow read: if ehAdmin() || (estaLogado() && request.auth.uid == uid);
        allow create: if estaLogado() && request.auth.uid == uid;
      }
    }

    match /contratos/{id} {
      allow read, write: if ehAdmin();
    }

    match /contratosPublicos/{token} {
      // O token (32 hex aleatórios) é o segredo do link enviado ao cliente:
      // quem tem o link lê aquele contrato; ninguém consegue listar.
      allow get: if true;
      allow list, create, delete: if ehAdmin();
      // Cliente (sem login) só pode assinar UMA vez, mexendo só na assinatura.
      allow update: if ehAdmin() ||
        (!('assinadoEm' in resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assinatura', 'assinadoEm']));
    }

    match /logisticaContratos/{id} {
      // Logística gerada automaticamente dos contratos assinados — só o admin.
      allow read, write: if ehAdmin();
    }

    match /brinquedos/{id} {
      // Qualquer operador logado precisa ver o catálogo pra saber o que
      // carregar; só o admin cadastra/edita/apaga um brinquedo.
      allow read: if estaLogado();
      allow write: if ehAdmin();
    }

    match /tarefasAtribuidas/{operadorUid}/itens/{id} {
      // O operador só lê as próprias tarefas atribuídas; só o admin atribui.
      allow read: if ehAdmin() || (estaLogado() && request.auth.uid == operadorUid);
      allow write: if ehAdmin();
    }

    // Consulta de todas as tarefas atribuídas de uma vez (Agenda de eventos e Planejamento do admin):
    // consultas em grupo de coleção exigem uma regra própria com /{path=**}/.
    match /{path=**}/itens/{id} {
      allow read: if ehAdmin();
    }

    match /configuracoes/{id} {
      // Qualquer operador logado pode ler (ex: gerar cobrança Pix em campo);
      // só o admin edita chave Pix e modelo de contrato.
      allow read: if estaLogado();
      allow write: if ehAdmin();
    }

    match /produtividade/{id} {
      // Cada operador só grava os próprios registros (validado pelo uid no
      // documento); só o admin lê o relatório do dia.
      allow read: if ehAdmin();
      allow write: if estaLogado() && request.resource.data.operadorUid == request.auth.uid;
    }

    match /emergencias/{id} {
      // Qualquer operador logado pode disparar uma emergência; só o admin lê
      // a lista e marca como resolvida.
      allow read, update: if ehAdmin();
      allow create: if estaLogado() && request.resource.data.operadorUid == request.auth.uid;
    }

    match /fechamentosDia/{data} {
      // Horário de fechamento da agenda por dia — qualquer logado lê, só o
      // admin define.
      allow read: if estaLogado();
      allow write: if ehAdmin();
    }
  }
}
