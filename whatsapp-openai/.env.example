# Copie este arquivo para .env e preencha os valores.
#   PowerShell:  Copy-Item .env.example .env

# Chave da API da OpenAI — https://platform.openai.com/api-keys
# Sem ela, o bot responde com mensagens fixas de fallback (o modo demo continua funcionando).
OPENAI_API_KEY=

# Modelo da OpenAI. Padrão: gpt-4o-mini (bom equilíbrio).
# Alternativa mais rápida e barata: gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Nome do assistente (aparece no dashboard e no prompt do sistema)
BOT_NAME=Bot

# (Opcional) Sobrescreve o prompt de sistema do bot
# BOT_SYSTEM_PROMPT=

# Porta do backend (Express + Socket.io)
PORT=3001

# Conectar ao WhatsApp ao iniciar (true/false).
# Em "false", o app sobe só com o modo demo (sem QR code).
WHATSAPP_ENABLED=true
