# ─── Nome da empresa ────────────────────────────────────────────────
# Aparece no cabeçalho das artes se não tiver logo (assets/logo.png)
COMPANY_NAME=Minha Empresa

# ─── Chave da OpenAI (obrigatório para !anuncio) ────────────────────
# Crie em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Senha de acesso ao gerador de anúncios ─────────────────────────
# Qualquer pessoa com este número precisará digitar esta senha
BOT_PASSWORD=minhasenha123

# ─── Qualidade das imagens geradas pela IA ──────────────────────────
# "standard" = $0.04 por imagem | "hd" = $0.08 por imagem
IMAGE_QUALITY=standard

# ─── Prompt personalizado (opcional) ────────────────────────────────
# Alternativa ao arquivo prompts/template.txt
# Use {TEMA} e {TELEFONE} como variáveis
# PROMPT_TEMPLATE=Crie um anúncio para {TEMA} com o número {TELEFONE}
